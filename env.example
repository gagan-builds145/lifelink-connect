# ---------------------------------------------------------------------------
# LifeLink environment template
# Copy this file to .env.local (frontend/CLI) and set values for your
# deployment. NEVER commit real secrets. Convex server secrets are set on the
# deployment with `bunx convex env set NAME "value"`, not exposed to Vite.
#
# The host blocks editing dot-prefixed .env files, so this template is named
# env.example. Copy it to .env.local yourself.
# ---------------------------------------------------------------------------

# Browser-visible Convex endpoints
VITE_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOYMENT=dev:your-deployment
CONVEX_SITE_URL=https://your-deployment.convex.site

# Optional: override the bundled auth background video
# VITE_AUTH_BG_VIDEO_URL=https://cdn.example.org/auth-bg.mp4

# ---------------------------------------------------------------------------
# Convex deployment variables (server-only)
# ---------------------------------------------------------------------------

# Email OTP gateway used by the existing LifeLink auth flow
VLY_INTEGRATION_KEY=
VLY_INTEGRATION_BASE_URL=https://integrations.vly.ai
VLY_CONVEX_AUTH_ISSUER=https://freebuff.com

# Python ML service (Convex deployment variables, not browser-visible).
# Convex Cloud cannot reach 127.0.0.1. Use a reachable HTTPS URL (a tunnel in
# development or a deployed service in production).
ML_SERVICE_URL=
ML_SERVICE_TOKEN=

# Python process variables (not Convex variables). In production set both.
# ML_REQUIRE_AUTH=true
# ML_SERVICE_TOKEN=<same value as the Convex deployment>
# ML_CORS_ORIGINS=https://your-app.example.org

# Transactional email (Resend). Without both values email jobs are
# marked skipped_no_provider; in-app notifications still work.
RESEND_API_KEY=
RESEND_FROM_EMAIL=LifeLink <alerts@yourdomain.org>

# SMS (Twilio). Without all three values SMS jobs are skipped_no_provider.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Live facility adapter credentials. The value here is only a NAME stored in
# facilityIntegrations.credentialEnvVar; the actual key is read server-side
# from the deployment environment. Rename these to match your HMS/blood bank.
RC_PUNE_INVENTORY_API_KEY=
SAHYADRI_HMS_TOKEN=

# Example real inventory endpoint contract:
# GET {baseUrl}/inventory
# Authorization: Bearer <credential>
# { "records": [{ "externalUnitRef": "...", "bloodGroup": "O+",
#   "component": "red_cells", "units": 4, "collectedAt": "2026-10-01",
#   "expiresAt": "2026-11-20", "storageLocation": "Cold room A",
#   "screened": true, "released": true, "storageTempC": 4 }] }
